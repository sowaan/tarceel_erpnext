 "content": "[{\"id\":\"tar_hero\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Tarceel \\u2014 WhatsApp for your documents</b></span>\",\"col\":12}},{\"id\":\"tar_intro\",\"type\":\"paragraph\",\"data\":{\"text\":\"Send &amp; receive WhatsApp messages from any document \\u2014 manually, from templates, or automatically via notifications, with delivery status right on the document timeline. New here? Open <b>Tarceel Settings</b> and connect your Tarceel account to get started.\",\"col\":12}},{\"id\":\"tar_sp1\",\"type\":\"spacer\",\"data\":{\"col\":12}},{\"id\":\"tar_qa\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h5\\\"><b>Quick Access</b></span>\",\"col\":12}},{\"id\":\"tar_sc1\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Tarceel Settings\",\"col\":3}},{\"id\":\"tar_sc2\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"WhatsApp Message Log\",\"col\":3}},{\"id\":\"tar_sc3\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"WhatsApp Message Template\",\"col\":3}},{\"id\":\"tar_sp2\",\"type\":\"spacer\",\"data\":{\"col\":12}},{\"id\":\"tar_mng\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h5\\\"><b>Manage</b></span>\",\"col\":12}},{\"id\":\"tar_card1\",\"type\":\"card\",\"data\":{\"card_name\":\"WhatsApp\",\"col\":4}}]",
